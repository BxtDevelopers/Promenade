# ─── Transactional email (already in use) ────────────────────────────────────
# SMTP credentials the contact/booking/referral forms send through.
MAILER_USER=
MAILER_PASS=

# ─── Google Places: live review rating ───────────────────────────────────────
# Powers the real star rating and review count rendered on the site and marked
# up as aggregateRating in the organization JSON-LD. Google requires that a
# marked-up rating also be visible on the page, so lib/googleReviews.ts returns
# available:false when either of these is missing and the UI omits the rating
# entirely rather than advertising "0.0".
#
# Results are cached for four days — review content changes slowly, the API
# quota does not.

# Places API key from the Google Cloud console. NOTE: this key is billable, so
# the GCP project behind it needs an owner and a billing account that the
# practice controls. Restrict it to the Places API.
GOOGLE_MAPS_API_KEY=

# Place ID for the practice's Google Business Profile. Public, not a secret —
# it is the same identifier the Business Profile exposes.
GOOGLE_PLACE_ID=

# ─── Google tag: GA4 + Google Ads ────────────────────────────────────────────
# Read on the server and passed to the tag component as props, so no
# NEXT_PUBLIC_ prefix is needed. Note that this does NOT keep the values out of
# the browser — gtag.js is fetched from a URL containing the measurement ID, so
# it is visible in DevTools on every site that runs Google Analytics. It keeps
# them out of the client bundle as build-time constants, nothing more.
#
# Most routes are statically prerendered, so changing one of these in Vercel
# requires a redeploy before it takes effect.
#
# Leave them empty to ship the site with no tag at all — that is the safe
# default. Preview deployments never load the tag regardless (gated on
# VERCEL_ENV), so QA traffic cannot skew the production property.

# GA4 measurement ID — Admin → Data streams → your web stream. Looks like G-XXXXXXXXXX.
GA_MEASUREMENT_ID=

# Google Ads conversion ID — Goals → Conversions → the tag setup screen.
# Looks like AW-123456789.
GOOGLE_ADS_ID=

# Conversion LABELS: the part after the slash in a send_to value such as
# AW-123456789/AbC-D_efGhIjKlM. Create two separate conversion actions in
# Google Ads — form fills and phone taps are worth different amounts and want
# separate bidding — and paste each label here. Getting these two the wrong way
# round fails silently, so check them against the action names in Ads.
GOOGLE_ADS_LEAD_LABEL=
GOOGLE_ADS_CALL_LABEL=

# ─── ChatGPT Ads pixel (oaiq) ────────────────────────────────────────────────
# Pixel ID from the "Setup code" panel in ChatGPT Ads Manager — the value
# passed to oaiq("init", { pixelId: ... }). Not a secret: it ships to the
# browser inside the init call, exactly like a GA4 measurement ID.
#
# Leave empty and the pixel does not load at all. Preview deployments never
# load it regardless (gated on VERCEL_ENV), so QA traffic cannot pollute
# ChatGPT Ads reporting.
#
# As with the Google IDs, most routes are statically prerendered, so setting
# this in Vercel requires a redeploy before it takes effect.
#
# `debug` is NOT configured here. The snippet OpenAI hands out sets
# debug: true, which is right for someone pasting it into a console and wrong
# for production; it follows NODE_ENV instead.
OPENAI_PIXEL_ID=
