# ─── Transactional email (already in use) ────────────────────────────────────
# SMTP credentials the contact/booking/referral forms send through.
MAILER_USER=
MAILER_PASS=

# ─── Google tag: GA4 + Google Ads ────────────────────────────────────────────
# Read on the server and passed to the tag component as props, so no
# NEXT_PUBLIC_ prefix is needed. Note that this does NOT keep the values out of
# the browser — gtag.js is fetched from a URL containing the measurement ID, so
# it is visible in DevTools on every site that runs Google Analytics. It keeps
# them out of the client bundle as build-time constants, nothing more.
#
# Most routes are statically prerendered, so changing one of these in Vercel
# requires a redeploy before it takes effect.
#
# Leave them empty to ship the site with no tag at all — that is the safe
# default. Preview deployments never load the tag regardless (gated on
# VERCEL_ENV), so QA traffic cannot skew the production property.

# GA4 measurement ID — Admin → Data streams → your web stream. Looks like G-XXXXXXXXXX.
GA_MEASUREMENT_ID=

# Google Ads conversion ID — Goals → Conversions → the tag setup screen.
# Looks like AW-123456789.
GOOGLE_ADS_ID=

# Conversion LABELS: the part after the slash in a send_to value such as
# AW-123456789/AbC-D_efGhIjKlM. Create two separate conversion actions in
# Google Ads — form fills and phone taps are worth different amounts and want
# separate bidding — and paste each label here. Getting these two the wrong way
# round fails silently, so check them against the action names in Ads.
GOOGLE_ADS_LEAD_LABEL=
GOOGLE_ADS_CALL_LABEL=

# ─── ChatGPT Ads pixel (oaiq) ────────────────────────────────────────────────
# Pixel ID from the "Setup code" panel in ChatGPT Ads Manager — the value
# passed to oaiq("init", { pixelId: ... }). Not a secret: it ships to the
# browser inside the init call, exactly like a GA4 measurement ID.
#
# Leave empty and the pixel does not load at all. Preview deployments never
# load it regardless (gated on VERCEL_ENV), so QA traffic cannot pollute
# ChatGPT Ads reporting.
#
# As with the Google IDs, most routes are statically prerendered, so setting
# this in Vercel requires a redeploy before it takes effect.
#
# `debug` is NOT configured here. The snippet OpenAI hands out sets
# debug: true, which is right for someone pasting it into a console and wrong
# for production; it follows NODE_ENV instead.
OPENAI_PIXEL_ID=

# ─── Dentva online scheduling widget ─────────────────────────────────────────
# Public booking token from the Dentva integration screen — the value that goes
# after /book/ in their embed URL, and in data-token on their popup snippet.
# Not a secret: it ships to the browser inside the iframe src.
#
# Leave empty and every "book an appointment" CTA falls back to the in-house
# request form (components/common/BookingModal.tsx), which emails the practice.
# That is a working booking path, so an unset or rotated token degrades to
# same-day callback rather than to a dead button.
#
# Preview deployments never load the widget (gated on VERCEL_ENV): bookings made
# against it land in the practice's live schedule, and a QA click that puts a
# fake patient in a real chair is worse than a preview without booking.
#
# As with the tag IDs above, most routes are statically prerendered, so setting
# this in Vercel requires a redeploy before it takes effect.
DENTVA_BOOKING_TOKEN=

# ─── NexHealth Synchronizer (online scheduling, evaluation) ──────────────────
# Server-only. Unlike the tag IDs above, the API key is a real credential: it
# reads and writes patient data. It must never carry a NEXT_PUBLIC_ prefix, and
# app/lib/nexhealth.ts imports "server-only" so a mistaken client import fails
# the build rather than shipping the key to the browser.
#
# Leave NEXHEALTH_API_KEY empty and booking falls back to the Dentva widget,
# and then to the in-house request form.
#
# Sandbox keys decode to a "...-sandbox" subject and are safe to develop
# against; production keys write into a live practice schedule.
NEXHEALTH_API_KEY=

# Institution subdomain, e.g. promenade-dental-demo-practice
NEXHEALTH_SUBDOMAIN=

# LOCATION id, not the institution id. GET /locations returns the institution
# at the top level with a nested `locations` array — the id you want is inside
# that array. Using the institution id yields 404s on appointment_types and
# operatories, which is a confusing way to discover the mistake.
NEXHEALTH_LOCATION_ID=

# Comma-separated provider ids whose availability is offered online.
NEXHEALTH_PROVIDER_IDS=

# https://nexhealth.info for sandbox. Defaults to sandbox when unset, so a
# missing value books into demo data rather than a real schedule. This means
# production MUST set it explicitly.
NEXHEALTH_BASE_URL=

# ─── Booking abuse guard ─────────────────────────────────────────────────────
# HMAC secret signing the short-lived grant that /api/booking/slots issues and
# /api/booking/appointments requires. Forces a caller to read availability
# before it can write to the schedule, and expires after 30 minutes.
#
# There is no default and no fallback: a hardcoded one would be published in
# this repository, which is the same as no signature while looking protected.
# The booking route refuses to accept bookings when this is unset — an
# unprotected public endpoint pointed at a real dentist's schedule is worse
# than no online booking at all.
#
# Any random string of 16+ characters: openssl rand -base64 32
BOOKING_GUARD_SECRET=
