# ─── Transactional email (already in use) ────────────────────────────────────
# SMTP credentials the contact/booking/referral forms send through.
MAILER_USER=
MAILER_PASS=

# ─── Google tag: GA4 + Google Ads ────────────────────────────────────────────
# All four are read at BUILD time (Next inlines NEXT_PUBLIC_* into the bundle),
# so after adding or changing one in Vercel you must redeploy for it to apply.
#
# Leave them empty to ship the site with no tag at all — that is the current
# production state, and it is the safe default. Preview deployments never load
# the tag regardless, so QA traffic cannot skew the production property.

# GA4 measurement ID — Admin → Data streams → your web stream. Looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID — Goals → Conversions → the tag setup screen.
# Looks like AW-123456789.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion LABELS: the part after the slash in a send_to value such as
# AW-123456789/AbC-D_efGhIjKlM. Create two separate conversion actions in
# Google Ads — form fills and phone taps are worth different amounts and want
# separate bidding — and paste each label here.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
